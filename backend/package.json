{
  "name": "donanex-api",
  "version": "1.0.0",
  "private": true,
  "description": "Çok satıcılı teknoloji mağazası API'si (Clean Architecture + CQRS, OAuth 2.0 / OIDC)",
  "main": "src/main.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/main.js",
    "dev": "node --watch src/main.js",
    "worker": "node src/worker.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/**/*.test.js\" \"tests/architecture/**/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"tests/integration/**/*.test.js\""
  },
  "dependencies": {
    "amqplib": "^0.10.9",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.16.3",
    "rate-limit-redis": "^4.2.1",
    "redis": "^5.8.2"
  }
}
