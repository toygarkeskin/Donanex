{
  "name": "bilgisayar-bilgileri-api",
  "version": "3.0.0",
  "private": true,
  "description": "Bilgisayar Bilgileri e-ticaret API'si (Clean Architecture + CQRS)",
  "main": "src/main.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/main.js",
    "dev": "node --watch src/main.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/**/*.test.js\" \"tests/architecture/**/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"tests/integration/**/*.test.js\""
  },
