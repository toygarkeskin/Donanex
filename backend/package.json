{
  "name": "donanex-api",
  "version": "1.0.0",
  "private": true,
  "description": "Çok satıcılı teknoloji mağazası API'si (Clean Architecture + CQRS, OAuth 2.0 / OIDC)",
  "main": "src/main.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node dist/main.js",
    "dev": "node --watch src/main.ts",
    "worker": "node dist/worker.js",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.js dist src",
    "typecheck": "tsc -p tsconfig.json",
    "pretest": "tsc -p tsconfig.json --noEmit false --outDir .build && node scripts/copy-assets.js .build .",
    "test": "node --test --test-concurrency=1 \".build/tests/**/*.test.js\"",
    "pretest:unit": "tsc -p tsconfig.json --noEmit false --outDir .build && node scripts/copy-assets.js .build .",
    "test:unit": "node --test \".build/tests/unit/**/*.test.js\" \".build/tests/architecture/**/*.test.js\"",
    "pretest:integration": "tsc -p tsconfig.json --noEmit false --outDir .build && node scripts/copy-assets.js .build .",
    "test:integration": "node --test --test-concurrency=1 \".build/tests/integration/**/*.test.js\""
  },
  "dependencies": {
    "amqplib": "^0.10.9",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.16.3",
    "rate-limit-redis": "^4.2.1",
    "redis": "^5.8.2"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
