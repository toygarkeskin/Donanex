{
  // Donanex backend — temel TypeScript yapılandırması.
  //
  // Bu dosya TİP DENETİMİ içindir (editör + "npm run typecheck"); çıktı üretmez.
  // Üretim derlemesi tsconfig.build.json ile yapılır.
  //
  // Geçiş TAMAMLANDI: src/ ve tests/ altında JavaScript dosyası kalmadı,
  // bu yüzden "allowJs" kapatıldı. Kapalı olması bir temizlik tercihi değil,
  // güvencenin kendisi: açık kalsaydı sonradan eklenen bir .js dosyası
  // sessizce denetim dışında kalır ve tip güvenliğinde fark edilmeyen bir
  // boşluk açardı. Artık böyle bir dosya derlemede çözümlenemez.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],

    // Proje CommonJS; require/module.exports düzeni korunuyor. ESM'e geçmek
    // ayrı bir karardır ve bu göçün kapsamı dışında.
    // TypeScript 7 eski "node" (node10) çözümlemesini kaldırdı; CommonJS için
    // doğru çift artık node16. package.json'da "type": "module" olmadığı için
    // dosyalar CommonJS sayılır.
    "module": "node16",
    "moduleResolution": "node16",

    // Asıl kazanç burada: tip hatalarını derlemede yakalamak.
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,

    // Bilinçli olarak KAPALI:
    //  · noUncheckedIndexedAccess — 10 bin satırlık göçte her dizi erişimini
    //    sarmalamak gürültü üretir; asıl değer strictNullChecks'te.
    //  · noUnusedParameters — Express ara katmanları imza gereği kullanılmayan
    //    "next" parametresi alır.
    "noUncheckedIndexedAccess": false,
    "noUnusedParameters": false,

    "allowJs": false,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  // scripts/ kapsam dışında: copy-assets.js ve generate-env.js uygulama kodu
  // değil, npm komutlarının doğrudan "node" ile çağırdığı derleme araçlarıdır.
  // Hiçbir kaynak dosya onları içe aktarmaz.
  "include": ["src/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist"]
}
