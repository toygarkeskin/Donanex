# Donanex — ÜRETİM yapılandırma örneği.
#
# Kullanımı:
#   1. node backend/scripts/generate-env.js > .env     (gizli değerleri üretir)
#   2. Aşağıdaki satırları .env içine taşıyın / üzerine yazın
#   3. docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# NOT: Bu dosya örnektir, gerçek değer içermez. .env'i ASLA git'e eklemeyin.

# ---------------------------------------------------------------------------
# Alan adı ve TLS
# ---------------------------------------------------------------------------
# DNS'te bu adın A (ve varsa AAAA) kaydı sunucunuzun IP'sine bakmalı.
# 80 ve 443 portları internete açık olmalı — Caddy sertifikayı böyle alır.
DOMAIN=donanex.com
# Let's Encrypt sertifika uyarılarını buraya gönderir.
ACME_EMAIL=siz@ornek.com

NODE_ENV=production
PUBLIC_URL=https://donanex.com

# HTTPS olmadan AÇMAYIN. true olduğunda tüm çerezler Secure olur ve
# HSTS başlığı eklenir. Sunucu bu değer false iken üretimde BAŞLAMAZ.
COOKIE_SECURE=true

# ---------------------------------------------------------------------------
# Üretimde kesinlikle kapalı
# ---------------------------------------------------------------------------
# Demo verisi üretimde yazılamaz; config doğrulaması reddeder.
SEED_DEMO_DATA=false

# DİKKAT — bu proje henüz GERÇEK bir ödeme sağlayıcısına bağlı değildir.
# "simulated" dışında bir değer verirseniz sunucu açılır ama ödeme ucu
# "Ödeme benzetimi bu ortamda kapalı." diyerek reddeder: sipariş verilir,
# ödenemez. Üretime almadan önce bir sağlayıcı (iyzico, PayTR, Stripe…)
# entegre edip ProcessPayment komutunu ona bağlamanız gerekir.
# Üretimde "simulated" bırakmak ise config doğrulamasına takılır ve
# sunucu hiç başlamaz — bilinçli bir frendir.
PAYMENTS_MODE=provider

# ---------------------------------------------------------------------------
# Gerçek e-posta
# ---------------------------------------------------------------------------
# Demo Mailpit'e gönderiyordu (SMTP_HOST=mail). Üretimde kendi sağlayıcınız:
SMTP_HOST=smtp.saglayiciniz.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=postakutusu@donanex.com
SMTP_PASSWORD=
SMTP_FROM=Donanex <bildirim@donanex.com>

# ---------------------------------------------------------------------------
# Gizli değerler — HEPSİNİ YENİLEYİN
# ---------------------------------------------------------------------------
# Demo .env'inden kopyalamayın; generate-env.js ile yeniden üretin.
#   DB_PASSWORD           veritabanı parolası
#   TOKEN_PEPPER          jeton özetleme anahtarı (en az 32 karakter)
#   JWT_PRIVATE_KEY       RS256 özel anahtar (PEM)
#   JWT_PUBLIC_KEY        RS256 açık anahtar (PEM)
#   RABBITMQ_PASSWORD     kuyruk parolası
#
# İlk yönetici parolası: boş bırakın, sistem güçlü bir parola üretip
# /app/var/bootstrap-admin.txt dosyasına yazar.
BOOTSTRAP_ADMIN_EMAIL=admin@donanex.com
BOOTSTRAP_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# OAuth dönüş adresi hakkında
# ---------------------------------------------------------------------------
# Ayrı bir değişken YOKTUR: izin verilen dönüş adresleri PUBLIC_URL'den
# türetilir ve her açılışta veritabanına yazılır. PUBLIC_URL doğruysa
# https://donanex.com/auth/callback kendiliğinden kayıtlı olur.
# Alan adını sonradan değiştirirseniz PUBLIC_URL'i güncelleyip yeniden
# başlatmanız yeterlidir.
