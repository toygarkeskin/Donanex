# Bu dosyayı .env adıyla kopyalayıp değerleri doldurun. .env asla Git'e eklenmez.
# Eksik veya zayıf değerlerle sunucu başlamayı reddeder.
#
# Hızlı başlangıç — tüm gizli değerleri tek komutla üretir:
#   node backend/scripts/generate-env.js > .env

NODE_ENV=development

# --- Veritabanı ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=pazar
DB_USER=pazar
DB_PASSWORD=

# --- Jetonlar ---
# RS256 anahtar çifti. Üretmek için: node backend/scripts/generate-env.js
# Tek satırda saklanır, satır sonları \n olarak yazılır.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Veritabanındaki jeton özetlerine karışan gizli değer (en az 32 karakter)
TOKEN_PEPPER=

# --- Adresler ve portlar ---
PUBLIC_URL=http://localhost:8090
WEB_PORT=8090
SEQ_PORT=8092
MAILPIT_PORT=8093
RABBITMQ_PORT=8094
DB_PUBLISH_PORT=5434
REDIS_PUBLISH_PORT=6380

# HTTPS arkasında MUTLAKA true
COOKIE_SECURE=false

# --- Kuyruk ---
RABBITMQ_USER=pazar
RABBITMQ_PASSWORD=

# --- Günlükler (Seq) ---
LOG_LEVEL=info
SEQ_API_KEY=

# --- E-posta ---
# Docker'da varsayılan olarak Mailpit kullanılır: e-posta gerçekten gönderilir
# ve http://localhost:8093 adresinde görünür, ama internete çıkmaz.
SMTP_HOST=mail
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Pazar <bildirim@pazar.test>

# --- İlk kurulum ---
# Sistem yöneticisi ilk açılışta oluşturulur. Parola boş bırakılırsa
# rastgele üretilir ve günlüğe + /app/var/bootstrap-admin.txt dosyasına yazılır.
BOOTSTRAP_ADMIN_EMAIL=admin@pazar.test
BOOTSTRAP_ADMIN_PASSWORD=
# Demo mağazaları, ürünleri ve siparişleri ekler. Canlıda false yapın.
SEED_DEMO_DATA=true

# --- Ödeme ---
# simulated: gerçek para hareketi yok, demo için başarı/başarısızlık seçilebilir.
# Gerçek sağlayıcı bağlanana kadar canlıda kullanmayın.
PAYMENTS_MODE=simulated
