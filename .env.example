# Bu dosyayı .env adıyla kopyalayıp değerleri doldurun. .env asla Git'e eklenmez.
# Sunucu, eksik veya zayıf değerlerle başlamayı reddeder.

NODE_ENV=production
PORT=3000

# Docker dışında (npm start) çalışırken kullanılır. Docker'da DB_HOST otomatik "db" olur.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=bilgisayar_bilgileri
DB_USER=bilgisayar
DB_PASSWORD=

# ADMIN_PASSWORD en az 12 karakter olmalı.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# En az 32 karakter. Üretmek için: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Sitenin dışarıdan görünen adresi (e-postalardaki bağlantılar bundan üretilir)
PUBLIC_URL=http://localhost:8080
# Docker portları
WEB_PORT=8080
DB_PUBLISH_PORT=5434

# Yerelde HTTP ile çalışmak için false. HTTPS arkasında MUTLAKA true.
COOKIE_SECURE=false
# Test ödeme ekranı. Gerçek ödeme sistemi bağlanınca veya canlıda MUTLAKA false.
ENABLE_TEST_PAYMENTS=true
# Ödenmeyen sipariş bu süre sonunda iptal edilir, stok iade edilir (dakika)
ORDER_PAYMENT_TTL_MINUTES=60

# İsteğe bağlı: destek yanıtları ve parola sıfırlama e-postaları için.
# Boş bırakılırsa e-posta gönderilmez (parola sıfırlama da çalışmaz).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
